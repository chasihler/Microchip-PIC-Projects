                      00295                 ;defined as TAD. A minimum wait of 2 TAD is
                      00296                 ;required before the next acquisition starts.
                      00297 
0024   1683           00298                 BSF STATUS,RP0 ;Bank 1
0025   1303           00299                 BCF STATUS,RP1 ;
                      00300                 
0026   3070           00301                 MOVLW B'01110000' ;A/D clock from internal clk
0027   009F           00302                 MOVWF ADCON1 ;
                      00303                 
