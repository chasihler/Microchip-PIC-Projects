                      00159 
                      00160                 ;RS-232 initialization
                      00161                 ;Port Map
                      00162                 ;               bit7    bit6    bit5    bit4    bit3    bit2    bit1    bit0
                      00163                 ;TXSTA  CSRC    TX9     TXEN    SYNC    SENDB   BRGH    TRMT    TX9D    0000 0010
                      00164                 ;RCSTA  SPEN    RX9     SREN    CREN    ADDEN   FERR    OERR    RX9D    0000 000X
                      00165                 ;
                      00166                 ;TXSTA
                      00167                 ;
                      00168                 ;bit 7 CSRC: Clock Source Select bit
                      00169                 ;       Asynchronous :
                      00170                 ;       Don’t care.
                      00171                 ;       Synchronous mode:
                      00172                 ;       1 = Master mode (clock generated internally from BRG)
                      00173                 ;       0 = Slave mode (clock from external source)
                      00174                 ;bit 6 TX9: 9-Bit Transmit Enable bit
                      00175                 ;       1 = Selects 9-bit transmission
                      00176                 ;       0 = Selects 8-bit transmission
                      00177                 ;bit 5 TXEN: Transmit Enable bit(1)
                      00178                 ;       1 = Transmit enabled
                      00179                 ;       0 = Transmit disabled
                      00180                 ;bit 4 SYNC: EUSART Mode Select bit
                      00181                 ;       1 = Synchronous mode
                      00182                 ;       0 = Asynchronous mode
                      00183                 ;bit 3 SENDB: Send Break Character bit
                      00184                 ;       Asynchronous mode:
                      00185                 ;       1 = Send Sync Break on next transmission (cleared by hardware upon completion)
                      00186                 ;       0 = Sync Break transmission completed
                      00187                 ;       Synchronous mode:
                      00188                 ;       Don’t care.
                      00189                 ;bit 2 BRGH: High Baud Rate Select bit
                      00190                 ;       Asynchronous mode:
                      00191                 ;       1 = High speed
                      00192                 ;       0 = Low speed
                      00193                 ;       Synchronous mode:
                      00194                 ;       Unused in this mode.
                      00195                 ;bit 1 TRMT: Transmit Shift Register Status bit
                      00196                 ;       1 = TSR is empty
MPASM  5.47                      MAIN_V0X.ASM   2-7-2013  19:06:00         PAGE  5


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

                      00197                 ;       0 = TSR is full
                      00198                 ;bit 0 TX9D: 9th Bit of Transmit Data
                      00199                 ;       Can be address/data bit or a parity bit
                      00200                 ;
                      00201                 ;RCSTA
                      00202                 ;
                      00203                 ;bit 7 SPEN: Serial Port Enable bit
                      00204                 ;       1 = Serial port enabled
                      00205                 ;       0 = Serial port disabled
                      00206                 ;bit 6 RX9: 9-Bit Receive Enable bit
                      00207                 ;       1 = Selects 9-bit reception
                      00208                 ;       0 = Selects 8-bit reception
                      00209                 ;bit 5 SREN: Single Receive Enable bit
                      00210                 ;       Asynchronous mode:
                      00211                 ;       Don’t care.
                      00212                 ;       Synchronous mode – Master:
                      00213                 ;       1 = Enables single receive
                      00214                 ;       0 = Disables single receive
                      00215                 ;       This bit is cleared after reception is complete.
                      00216                 ;       Synchronous mode – Slave:
                      00217                 ;       Don’t care.
                      00218                 ;bit 4 CREN: Continuous Receive Enable bit
                      00219                 ;       Asynchronous mode:
                      00220                 ;       1 = Enables receiver
                      00221                 ;       0 = Disables receiver
                      00222                 ;       Synchronous mode:
                      00223                 ;       1 = Enables continuous receive until enable bit, CREN, is cleared (CREN override
                            s SREN)
                      00224                 ;       0 = Disables continuous receive
                      00225                 ;bit 3 ADDEN: Address Detect Enable bit
                      00226                 ;       Asynchronous mode 9-Bit (RX9 = 1):
                      00227                 ;       1 = Enables address detection, enables interrupt and loads the receive buffer wh
                            en RSR<8> is set
                      00228                 ;       0 = Disables address detection, all bytes are received and ninth bit can be used
                             as parity bit
                      00229                 ;       Asynchronous mode 8-Bit (RX9 = 0):
                      00230                 ;       Don’t care.
                      00231                 ;bit 2 FERR: Framing Error bit
                      00232                 ;       1 = Framing error (can be cleared by reading RCREGx register and receiving next 
                            valid byte)
                      00233                 ;       0 = No framing error
                      00234                 ;bit 1 OERR: Overrun Error bit
                      00235                 ;       1 = Overrun error (can be cleared by clearing bit, CREN)
                      00236                 ;       0 = No overrun error
                      00237                 ;bit 0 RX9D: 9th Bit of Received Data
                      00238                 ;       This can be address/data bit or a parity bit and must be calculated by user firm
                            ware.
                      00239         ;Clock Frequence Determination
                      00240         ;       For a device with FOSC of 16 MHz, desired baud rate of 9600, Asynchronous mode, 8-bit BR
                            G:
                      00241         ;       Desired Baud Rate = FOSC/(64 ([SPBRGH:SPBRG] + 1))
                      00242         ;       Solving for SPBRGH:SPBRG:
                      00243         ;       X = ((FOSC/Desired Baud Rate)/64) – 1
MPASM  5.47                      MAIN_V0X.ASM   2-7-2013  19:06:00         PAGE  6


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

                      00244         ;       = ((16000000/9600)/64) – 1
                      00245         ;       = [25.042] = 25
                      00246         ;       Calculated Baud Rate = 16000000/(64 (25 + 1))
                      00247         ;       = 9615
                      00248         ;       Error = (Calculated Baud Rate – Desired Baud Rate)/Desired Baud Rate
                      00249         ;       = (9615 – 9600)/9600 = 0.16%
                      00250         ;The PIC16F690 has one or two quirks that are only hinted about in the EUSART section. One is th
                            at RX input is shared with AN11. If you don't set ANSELH bit 3 to zero the receiver never works.
                      00251         ;• SPEN (RCSTA<7>) bit must be set (= 1),
                      00252         ;• TRISB<6> bit must be set (= 1), and
                      00253         ;• TRISB<7> bit must be set (= 1).
                      00254 
001A   1683           00255                 bsf     STATUS, RP0                             ;Bank 1
001B   1303           00256                 bcf     STATUS, RP1
                      00257                 ;bsf    BAUDCTL,3
                      00258 
001C   30A4           00259                 movlw    b'10100100'        ;initialize USART
001D   0098           00260             movwf    TXSTA              ;8-bit, Async, High Speed, tx enable                            
                                                            
                      00261                                                                         ;9615bps 
001E   3019           00262         movlw 0x19                      ; 0x19=9600 bps (0x0C=19200 bps)
001F   0099           00263         movwf SPBRG             
                      00264 
                      00265 
0020   1283           00266                 bcf     STATUS, RP0                             ;Bank 0
0021   1303           00267                 bcf     STATUS, RP1
                      00268 
0022   3090           00269             movlw    b'10010000'
0023   0098           00270             movwf    RCSTA                              ;Enable Port SPEN&CREN
                      00271 
                      00272 
                      00273                 ;1. Configure the A/D module:
                      00274                 ;• Configure analog/digital I/O (ANSx)
                      00275                 ;• Select A/D conversion clock (ADCON1<6:4>)
                      00276                 ;• Configure voltage reference (ADCON0<6>)
                      00277                 ;• Select A/D input channel (ADCON0<5:2>)
                      00278                 ;• Select result format (ADCON0<7>)
                      00279                 ;• Turn on A/D module (ADCON0<0>)
                      00280                 ;2. Configure A/D interrupt (if desired):
                      00281                 ;• Clear ADIF bit (PIR1<6>)
                      00282                 ;• Set ADIE bit (PIE1<6>)
                      00283                 ;• Set PEIE and GIE bits (INTCON<7:6>)
                      00284                 ;3. Wait the required acquisition time.
                      00285                 ;4. Start conversion:
                      00286                 ;• Set GO/DONE bit (ADCON0<1>)
                      00287                 ;5. Wait for A/D conversion to complete, by either:
                      00288                 ;• Polling for the GO/DONE bit to be cleared
                      00289                 ;(with interrupts disabled); OR
                      00290                 ;• Waiting for the A/D interrupt
                      00291                 ;6. Read A/D Result register pair
                      00292                 ;(ADRESH:ADRESL), clear bit ADIF if required.
                      00293                 ;7. For next conversion, go to step 1 or step 2 as
                      00294                 ;required. The A/D conversion time per bit is
MPASM  5.47                      MAIN_V0X.ASM   2-7-2013  19:06:00         PAGE  7


