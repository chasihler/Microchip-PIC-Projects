                      00164 ;-------------------------------------------------------
                      00165 ;RS-232 initialization
                      00166 ;Port Map
                      00167 ;               bit7    bit6    bit5    bit4    bit3    bit2    bit1    bit0
                      00168 ;TXSTA  CSRC    TX9     TXEN    SYNC    SENDB   BRGH    TRMT    TX9D    0000 0010
                      00169 ;RCSTA  SPEN    RX9     SREN    CREN    ADDEN   FERR    OERR    RX9D    0000 000X
                      00170 ;
                      00171 ;TXSTA
                      00172 ;
                      00173 ;bit 7 CSRC: Clock Source Select bit
                      00174 ;       Asynchronous mode:
                      00175 ;       Don’t care.
                      00176 ;       Synchronous mode:
                      00177 ;       1 = Master mode (clock generated internally from BRG)
                      00178 ;       0 = Slave mode (clock from external source)
                      00179 ;bit 6 TX9: 9-Bit Transmit Enable bit
                      00180 ;       1 = Selects 9-bit transmission
                      00181 ;       0 = Selects 8-bit transmission
                      00182 ;bit 5 TXEN: Transmit Enable bit(1)
                      00183 ;       1 = Transmit enabled
                      00184 ;       0 = Transmit disabled
                      00185 ;bit 4 SYNC: EUSART Mode Select bit
                      00186 ;       1 = Synchronous mode
                      00187 ;       0 = Asynchronous mode
                      00188 ;bit 3 SENDB: Send Break Character bit
                      00189 ;       Asynchronous mode:
                      00190 ;       1 = Send Sync Break on next transmission (cleared by hardware upon completion)
                      00191 ;       0 = Sync Break transmission completed
                      00192 ;       Synchronous mode:
                      00193 ;       Don’t care.
                      00194 ;bit 2 BRGH: High Baud Rate Select bit
                      00195 ;       Asynchronous mode:
                      00196 ;       1 = High speed
                      00197 ;       0 = Low speed
                      00198 ;       Synchronous mode:
                      00199 ;       Unused in this mode.
                      00200 ;bit 1 TRMT: Transmit Shift Register Status bit
MPASM  5.47                             M.ASM   2-8-2013  16:28:28         PAGE  5


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

                      00201 ;       1 = TSR is empty
                      00202 ;       0 = TSR is full
                      00203 ;bit 0 TX9D: 9th Bit of Transmit Data
                      00204 ;       Can be address/data bit or a parity bit
                      00205 ;
                      00206 ;
                      00207 ;
                      00208 ;RCSTA
                      00209 ;
                      00210 ;bit 7 SPEN: Serial Port Enable bit
                      00211 ;       1 = Serial port enabled
                      00212 ;       0 = Serial port disabled
                      00213 ;bit 6 RX9: 9-Bit Receive Enable bit
                      00214 ;       1 = Selects 9-bit reception
                      00215 ;       0 = Selects 8-bit reception
                      00216 ;bit 5 SREN: Single Receive Enable bit
                      00217 ;       Asynchronous mode:
                      00218 ;       Don’t care.
                      00219 ;       Synchronous mode – Master:
                      00220 ;       1 = Enables single receive
                      00221 ;       0 = Disables single receive
                      00222 ;       This bit is cleared after reception is complete.
                      00223 ;       Synchronous mode – Slave:
                      00224 ;       Don’t care.
                      00225 ;bit 4 CREN: Continuous Receive Enable bit
                      00226 ;       Asynchronous mode:
                      00227 ;       1 = Enables receiver
                      00228 ;       0 = Disables receiver
                      00229 ;       Synchronous mode:
                      00230 ;       1 = Enables continuous receive until enable bit, CREN, is cleared (CREN overrides SREN)
                      00231 ;       0 = Disables continuous receive
                      00232 ;bit 3 ADDEN: Address Detect Enable bit
                      00233 ;       Asynchronous mode 9-Bit (RX9 = 1):
                      00234 ;       1 = Enables address detection, enables interrupt and loads the receive buffer when RSR<8> is set
                      00235 ;       0 = Disables address detection, all bytes are received and ninth bit can be used as parity bit
                      00236 ;       Asynchronous mode 8-Bit (RX9 = 0):
                      00237 ;       Don’t care.
                      00238 ;bit 2 FERR: Framing Error bit
                      00239 ;       1 = Framing error (can be cleared by reading RCREGx register and receiving next valid byte)
                      00240 ;       0 = No framing error
                      00241 ;bit 1 OERR: Overrun Error bit
                      00242 ;       1 = Overrun error (can be cleared by clearing bit, CREN)
                      00243 ;       0 = No overrun error
                      00244 ;bit 0 RX9D: 9th Bit of Received Data
                      00245 ;       This can be address/data bit or a parity bit and must be calculated by user firmware.
                      00246 ;
                      00247 ;
                      00248 ;Clock Frequence Determination
                      00249 ;       For a device with FOSC of 16 MHz, desired baud rate of 9600, Asynchronous mode, 8-bit BRG:
                      00250 ;       Desired Baud Rate = FOSC/(64 ([SPBRGH:SPBRG] + 1))
                      00251 ;       Solving for SPBRGH:SPBRG:
                      00252 ;       X = ((FOSC/Desired Baud Rate)/64) – 1
                      00253 ;       = ((16000000/9600)/64) – 1
MPASM  5.47                             M.ASM   2-8-2013  16:28:28         PAGE  6


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

                      00254 ;       = [25.042] = 25
                      00255 ;       Calculated Baud Rate = 16000000/(64 (25 + 1))
                      00256 ;       = 9615
                      00257 ;       Error = (Calculated Baud Rate – Desired Baud Rate)/Desired Baud Rate
                      00258 ;       = (9615 – 9600)/9600 = 0.16%
                      00259 ;
                      00260 ;
                      00261 ;-------------------------------------------------------
                      00262 
000056                00263 init_232
000056 0EA4           00264         movlw    B'10100100'        ;initialize USART
000058 6EAC           00265     movwf    TXSTA              ;8-bit, Async, High Speed, tx enable
                      00266 ;   movlw    .25
                      00267 ;       movlw   .26
00005A 0E67           00268         movlw    .103                           ;9600 Baud
00005C 6EAF           00269     movwf    SPBRG              ;into 8bit baud rate generator
00005E 0E90           00270     movlw    B'10010000'
000060 6EAB           00271     movwf    RCSTA                              ;Enable Port SPEN&CREN
000062 0012           00272         return
                      00273 
                      00274 ;       • SPEN (RCSTA<7>) bit must be set ( = 1),
                      00275 ;       • TRISC<6> bit must be set ( = 1), and
                      00276 ;       • TRISC<7> bit must be set ( = 1).
                      00277 
                      00278 
